doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title Verify your email
  body
    h1 Verify your email, #{fullName || 'there'}
    p Use this verification code to complete your Banao registration:
    p(style="font-size: 24px; font-weight: bold; letter-spacing: 4px")= otp
    p This code expires in #{expiryMinutes} minutes.
    p If you did not create a Banao account, you can ignore this email.
