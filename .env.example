# Application
PORT=3000

# PostgreSQL / PostGIS (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/banao?schema=public"
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=banao

# Authentication and email verification
# Replace these placeholder values with strong, unique secrets outside local development.
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-token-secret
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=2592000
OTP_SECRET=replace-with-a-long-random-otp-secret
EXPIRY_MINUTES=10

# SMTP email delivery. Use credentials from your email provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
MAIL_FROM="Banao <no-reply@example.com>"
SMTP_SECURE=false
